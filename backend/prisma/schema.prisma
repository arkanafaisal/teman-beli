generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  name         String
  department   String?  // Jurusan (Misal: "Informatika UNS") - opsional, bisa diisi belakangan
  rating       Float    @default(0.0)  // Nilai ulasan (Misal: 4.9)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patungansHosted Patungan[] @relation("HostPatungan")
  participations  PatunganParticipant[] @relation("UserParticipation")
  reviewsGiven    Review[]   @relation("GivenReviews")
  reviewsReceived Review[]   @relation("ReceivedReviews")
}

enum PatunganStatus {
  OPEN
  FULL
  FINISHED
  CANCELLED
}

enum PatunganCategory {
  PANGAN
  KOS
  KAMPUS
  DIGITAL
}

model Patungan {
  id           String   @id @default(uuid())
  title        String
  category     PatunganCategory
  unit         String
  targetQuota  Int
  totalPrice   Float
  currentQuota Int      @default(0)
  area         String
  deadline     DateTime
  whatsapp     String
  notes        String?
  refLink      String?
  proofLink    String?
  status       PatunganStatus @default(OPEN)

  hostId       String
  host         User     @relation("HostPatungan", fields: [hostId], references: [id])

  participants PatunganParticipant[]
  logs         PatunganLog[]
  reviews      Review[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model PatunganParticipant {
  id         String   @id @default(uuid())
  patunganId String
  userId     String
  quota      Int
  status     ParticipantStatus @default(PENDING)

  patungan   Patungan @relation(fields: [patunganId], references: [id])
  user       User     @relation("UserParticipation", fields: [userId], references: [id])

  joinedAt   DateTime @default(now())
}

model PatunganLog {
  id         String   @id @default(uuid())
  patunganId String
  text       String

  patungan   Patungan @relation(fields: [patunganId], references: [id])

  createdAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?

  reviewerId String
  reviewer   User     @relation("GivenReviews", fields: [reviewerId], references: [id])

  hostId     String
  host       User     @relation("ReceivedReviews", fields: [hostId], references: [id])

  patunganId String
  patungan   Patungan @relation(fields: [patunganId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([reviewerId, patunganId])
}
