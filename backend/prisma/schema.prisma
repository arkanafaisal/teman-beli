generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  department   String?  // Jurusan (Misal: "Informatika UNS") - opsional, bisa diisi belakangan
  rating       Float    @default(0.0)  // Nilai ulasan (Misal: 4.9)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
